# REACT_APP_ values are bundled into the browser.
REACT_APP_EMAIL_USER=          # EmailJS public key (booking form)
REACT_APP_EMAIL_SERVICE=       # EmailJS service ID
REACT_APP_EMAIL_TEMPLATE=      # EmailJS template ID
REACT_APP_CONTENTFUL_SPACE=    # Contentful space ID
REACT_APP_CONTENTFUL_API=      # Contentful Delivery API token (read-only)
